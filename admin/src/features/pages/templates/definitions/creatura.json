        { "key": "ca", "label": "Classe Armatura", "type": "number", "placeholder": "15" },
        { "key": "pf", "label": "Punti Ferita", "type": "text", "placeholder": "7 (2d6)" },
        { "key": "velocita", "label": "Velocità", "type": "text", "placeholder": "9 m" },
        { "key": "sfida", "label": "Grado di Sfida", "type": "text", "placeholder": "1/4 (50 PE)" },
        { "key": "linguaggi", "label": "Linguaggi", "type": "text", "placeholder": "Comune, Goblin" },
        {
          "key": "descrizione",
          "label": "Descrizione",
          "type": "text",
          "placeholder": "Piccolo umanoide che tende agguati nei boschi."
        },
        {
          "key": "tratti",
          "label": "Tratti",
          "type": "tags",
          "placeholder": "Furtivo. Si nasconde come azione bonus."
        },
        {
          "key": "azioni",
          "label": "Azioni",
          "type": "tags",
          "placeholder": "Scimitarra. +4 al colpire, 1d6+2 danni taglienti."
        },
        {
          "key": "reazioni",
          "label": "Reazioni",
          "type": "tags",
          "placeholder": "Ritirata rapida. Si muove di metà velocità."
        },
        {
          "key": "tattiche",
          "label": "Tattiche",
          "type": "tags",
          "placeholder": "Attacca in branchi di almeno tre."
        }
