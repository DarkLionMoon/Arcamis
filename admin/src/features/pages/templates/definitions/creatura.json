        {
          "key": "tipo",
          "label": "Tipo",
          "type": "select",
          "options": [
            { "value": "Aberrazione", "label": "Aberrazione" },
            { "value": "Bestia", "label": "Bestia" },
            { "value": "Celestiale", "label": "Celestiale" },
            { "value": "Costrutto", "label": "Costrutto" },
            { "value": "Drago", "label": "Drago" },
            { "value": "Elementale", "label": "Elementale" },
            { "value": "Fata", "label": "Fata" },
            { "value": "Gigante", "label": "Gigante" },
            { "value": "Immondo", "label": "Immondo" },
            { "value": "Melma", "label": "Melma" },
            { "value": "Mostruosità", "label": "Mostruosità" },
            { "value": "Non morto", "label": "Non morto" },
            { "value": "Pianta", "label": "Pianta" },
            { "value": "Umanoide", "label": "Umanoide" }
          ]
        },
        {
          "key": "taglia",
