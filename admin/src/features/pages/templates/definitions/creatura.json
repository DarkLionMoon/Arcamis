            { "value": "Minuscola", "label": "Minuscola" },
            { "value": "Piccola", "label": "Piccola" },
            { "value": "Media", "label": "Media" },
            { "value": "Grande", "label": "Grande" },
            { "value": "Enorme", "label": "Enorme" },
            { "value": "Mastodontica", "label": "Mastodontica" }
          ]
        },
        {
          "key": "allineamento",
