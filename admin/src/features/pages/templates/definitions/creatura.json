            "blocks": [{ "kind": "bullets", "field": "azioni" }]
          },
          {
            "heading": "Reazioni",
            "level": 3,
            "blocks": [{ "kind": "bullets", "field": "reazioni" }]
          },
          {
            "heading": "Tattiche",
            "level": 3,
            "blocks": [{ "kind": "bullets", "field": "tattiche" }]
          }
        ]
      }
    }
