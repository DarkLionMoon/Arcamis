/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=(self)
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; media-src 'self' blob: https:; frame-src 'self' https://www.youtube.com https://player.vimeo.com; connect-src 'self' https://discord.com https://arcamis.pages.dev https://docs.google.com https://api.github.com; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/content/*
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
/admin
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/export/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/scripts/js/*
  Cache-Control: public, max-age=0, must-revalidate

/scripts/css/*
  Cache-Control: public, max-age=31536000, immutable

/*.{png,webp,jpg,svg,ico}
  Cache-Control: public, max-age=604800
