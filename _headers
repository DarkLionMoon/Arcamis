/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), autoplay=(self)
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https:; frame-src 'self' https://www.youtube.com https://player.vimeo.com; connect-src 'self' https://discord.com https://arcamis.pages.dev https://docs.google.com https://api.github.com https://cloudflareinsights.com; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/content/*
  Cache-Control: public, max-age=0, must-revalidate

/admin/*
/admin
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/export/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Exact rules for fingerprinted CSS and JS are generated by build-post.mjs.
# Mutable images keep the Pages default revalidation policy, so admin
# changes remain visible without waiting for an image cache to expire.

# Font self-hosted: nome con hash del contenuto → cache immutabile.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/sitemap.xml
/robots.txt
  Cache-Control: public, max-age=3600
