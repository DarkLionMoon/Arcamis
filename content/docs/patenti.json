der-top-style:solid;border-left-style:solid;border-bottom-width:1pt;width:60.8pt;border-top-color:#000000;border-bottom-style:solid}.c1{margin-left:36pt;padding-top:0pt;padding-left:0pt;padding-bottom:12pt;line-height:1.15;orphans:2;widows:2;text-align:justify}.c10{padding-top:0pt;padding-bottom:3pt;line-height:1.15;orphans:2;widows:2;text-align:justify;height:11pt}.c25{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:\"Arial\";font-style:italic}.c0{color:#000000;font-weight:400;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:\"Arial\";font-style:normal}.c21{padding-top:3pt;padding-bottom:3pt;line-height:1.0;orphans:2;widows:2;text-align:justify;height:11pt}.c13{color:#000000;text-decoration:none;vertical-align:baseline;font-size:17pt;font-family:\"Arial\";font-style:normal}.c28{color:#2d5016;text-decoration:none;vertical-align:baseline;font-size:24pt;font-family:\"Arial\";font-style:normal}.c22{color:#000000;text-decoration:none;vertical-align:baseline;font-size:11pt;font-family:\"Arial\";font-style:normal}.c11{padding-top:0pt;padding-bottom:12pt;line-height:1.15;orphans:2;widows:2;text-align:justify}.c9{padding-top:0pt;padding-bottom:4pt;line-height:1.15;orphans:2;widows:2;text-align:justify}.c29{color:#000000;text-decoration:none;vertical-align:baseline;font-size:23pt;font-family:\"Arial\";font-style:normal}.c27{padding-top:0pt;padding-bottom:6pt;line-height:1.15;orphans:2;widows:2;text-align:justify}.c3{padding-top:0pt;padding-bottom:24pt;line-height:1.15;orphans:2;widows:2;text-align:justify}.c19{color:#000000;text-decoration:none;vertical-align:baseline;font-size:13pt;font-family:\"Arial\";font-style:normal}.c32{margin-left:-10.5pt;border-spacing:0;border-collapse:collapse;margin-right:auto}.c30{border-spacing:0;border-collapse:collapse;margin-right:auto}.c24{background-color:#ffffff;max-width:451.3pt;padding:72pt 72pt 72pt 72pt}.c26{margin-left:36pt;height:11pt}.c16{margin-left:72pt;padding-left:0pt}.c5{padding:0;margin:0}.c15{height:40.8pt}.c31{font-style:italic}.c2{font-weight:700}.c23{height:26.5pt}.title{padding-top:0pt;color:#000000;font-size:28pt;padding-bottom:0pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}.subtitle{padding-top:18pt;color:#666666;font-size:24pt;padding-bottom:4pt;font-family:\"Georgia\";line-height:1.0;page-break-after:avoid;font-style:italic;orphans:2;widows:2;text-align:left}li{color:#000000;font-size:11pt;font-family:\"Arial\"}p{margin:0;color:#000000;font-size:11pt;font-family:\"Arial\"}h1{padding-top:20pt;color:#2d5016;font-weight:700;font-size:18pt;padding-bottom:10pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}h2{padding-top:16pt;color:#4a6741;font-weight:700;font-size:14pt;padding-bottom:8pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}h3{padding-top:12pt;color:#5c7a53;font-weight:700;font-size:12pt;padding-bottom:6pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}h4{padding-top:0pt;color:#2e74b5;font-size:11pt;padding-bottom:0pt;font-family:\"Arial\";line-height:1.0;font-style:italic;orphans:2;widows:2;text-align:left}h5{padding-top:0pt;color:#2e74b5;font-size:11pt;padding-bottom:0pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}h6{padding-top:0pt;color:#1f4d78;font-size:11pt;padding-bottom:0pt;font-family:\"Arial\";line-height:1.0;orphans:2;widows:2;text-align:left}</style></head><body class=\"c24 doc-content\"><p class=\"c10\"><span class=\"c0\"></span></p><h1 class=\"c27\" id=\"h.o8qbilcunyak\"><span class=\"c2 c29\">&#9878;&#65039; CODICE PATENTI DI ARCADIA</span></h1><p class=\"c11\"><span class=\"c22 c2\">Ufficio del Registro e della Vigilanza (U.R.V.) &mdash; Regno di Arcadia</span></p><p class=\"c11\"><span>Il presente sistema regola l&#39;esercizio dei mestieri, la compravendita di manufatti e l&#39;uso di sostanze speciali nel Regno. Ogni licenza ha una </span><span class=\"c2\">durata triennale</span><span>&nbsp;e il possesso del </span><span class=\"c2\">Sigillo di Riconoscimento</span><span class=\"c0\">&nbsp;(medaglione incantato) garantisce lo status legale dell&#39;artigiano.</span></p><h2 class=\"c9\" id=\"h.goyv4mkzl2w\"><span class=\"c2 c13\">&#127775; Vantaggi Generali del Licenziatario</span></h2><p class=\"c11\"><span class=\"c0\">Il possesso di una patente valida offre benefici immediati a ogni cittadino di Arcadia:</span></p><ul class=\"c5 lst-kix_hqae4iojn6jo-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Protezione Legale</span><span class=\"c0\">: Intervento prioritario della Guardia cittadina in caso di truffe o controversie commerciali.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Accesso ai Grandi Appalti</span><span class=\"c0\">: Solo i licenziatari possono partecipare a commesse statali superiori alle 1.000 Mo.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Prestigio Professionale</span><span>: Vantaggio alle prove di </span><span class=\"c2\">Persuasione</span><span class=\"c0\">&nbsp;legate al proprio mestiere mostrando il Sigillo.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Assicurazione Statale</span><span class=\"c0\">: Copertura del 30% dei danni in caso di incidenti documentati in laboratorio.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Diritto di Bottega</span><span class=\"c0\">: Esenzione dai controlli arbitrari e diritto di esporre l&#39;insegna ufficiale.</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.81zp9bns73ns\"><span class=\"c13 c2\">&#128202; Quadro Generale delle Patenti</span></h2><table class=\"c32\"><tr class=\"c15\"><td class=\"c6\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Sigla</span></p></td><td class=\"c4\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Denominazione</span></p></td><td class=\"c17\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Costo (3 anni)</span></p></td><td class=\"c8\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Cauzione</span></p></td><td class=\"c14\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Totale</span></p></td></tr><tr class=\"c23\"><td class=\"c6\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">P.M.C.</span></p></td><td class=\"c4\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Manifattura Comune</span></p></td><td class=\"c17\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">40 Mo</span></p></td><td class=\"c8\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">10 Mo</span></p></td><td class=\"c14\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">50 Mo</span></p></td></tr><tr class=\"c15\"><td class=\"c6\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">P.M.T.</span></p></td><td class=\"c4\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Manifattura Tecnica</span></p></td><td class=\"c17\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">85 Mo</span></p></td><td class=\"c8\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">25 Mo</span></p></td><td class=\"c14\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">110 Mo</span></p></td></tr><tr class=\"c15\"><td class=\"c6\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">P.A.S.V.</span></p></td><td class=\"c4\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Alchimia e Sostanze Vincolate</span></p></td><td class=\"c17\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">140 Mo</span></p></td><td class=\"c8\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">40 Mo</span></p></td><td class=\"c14\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">180 Mo</span></p></td></tr><tr class=\"c15\"><td class=\"c6\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">P.O.E.</span></p></td><td class=\"c4\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Opere Eccezionali</span></p></td><td class=\"c17\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">300 Mo</span></p></td><td class=\"c8\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">100 Mo</span></p></td><td class=\"c14\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">400 Mo</span></p></td></tr></table><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.1lc77wib28st\"><span class=\"c13 c2\">&#128220; Dettaglio delle Licenze</span></h2><h3 class=\"c9\" id=\"h.30cyvhhxmht3\"><span class=\"c19 c2\">1. P.M.C. &mdash; Manifattura Comune</span></h3><p class=\"c11\"><span class=\"c25\">Ideale per: Osti, Sarti, Falegnami e Artisti.</span></p><ul class=\"c5 lst-kix_8hdlgsgxilwb-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Permessi</span><span class=\"c0\">: Vendita di beni comuni (cibo, abiti, mobili, arte non magica). Commesse fino a 500 Mo.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Materiali</span><span class=\"c0\">: Acquisto libero di materie prime ordinarie e alcol fino al Grado II.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Limiti</span><span class=\"c0\">: Divieto assoluto di produrre veleni o sostanze alchemiche pure.</span></li></ul><h3 class=\"c9\" id=\"h.buackrli5sgh\"><span class=\"c19 c2\">2. P.M.T. &mdash; Manifattura Tecnica</span></h3><p class=\"c11\"><span class=\"c25\">Ideale per: Fabbri, Gioiellieri, Architetti e Cartografi ufficiali.</span></p><ul class=\"c5 lst-kix_5tmmyfy1hhmk-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Permessi</span><span>: Produzione di armi, armature pesanti, strutture civili/militari e oggetti magici </span><span class=\"c2\">Comuni</span><span class=\"c0\">. Emissione di documenti legali e mappe ufficiali.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Materiali</span><span class=\"c0\">: Accesso a cristalli conduttori (Hextech Grado I) e leghe speciali (Acciaio di Noxus, ecc.).</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Obblighi</span><span class=\"c0\">: Responsabilit&agrave; legale sulla stabilit&agrave; delle strutture e tracciabilit&agrave; delle armi da guerra.</span></li></ul><h3 class=\"c9\" id=\"h.x8t6tad8iie5\"><span class=\"c19 c2\">3. P.A.S.V. &mdash; Alchimia e Sostanze Vincolate</span></h3><p class=\"c11\"><span class=\"c25\">Ideale per: Alchimisti e Artigiani Hextech.</span></p><ul class=\"c5 lst-kix_5h3tac1fkuur-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Permessi</span><span>: Produzione di pozioni (fino a Non Comuni), veleni etichettati e motori Hextech. </span><span class=\"c2\">Unica licenza</span><span class=\"c0\">&nbsp;che permette l&#39;acquisto di Inchiostri Magici.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Materiali</span><span class=\"c0\">: Reagenti rari (Sangue di Demone, Ghiandola di Drago) e inchiostri fino al Grado III.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Rigore</span><span>: Ogni boccetta &egrave; tracciata tramite il </span><span class=\"c2\">Marchio Spettrale</span><span class=\"c0\">&nbsp;e ogni transazione registrata nel Libretto degli Acquisti.</span></li></ul><h3 class=\"c9\" id=\"h.xiiinggqve82\"><span class=\"c2 c19\">4. P.O.E. &mdash; Opere Eccezionali</span></h3><p class=\"c11\"><span class=\"c25\">Riservata ai Maestri Artigiani (Livello 4+).</span></p><ul class=\"c5 lst-kix_vmnhojpcuxfy-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Permessi</span><span class=\"c0\">: Accesso alle commesse della Corte e titoli onorifici.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Privilegi</span><span class=\"c0\">: Diritto di formare fino a 3 apprendisti e certificare la qualit&agrave; delle opere (+20% valore di mercato).</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Materiali</span><span class=\"c0\">: Accesso a materiali speciali su approvazione del Consiglio.</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.hax7x7l9skta\"><span class=\"c13 c2\">&#129514; Sezione Tecnica: Materiali Vincolati e Inchiostri</span></h2><p class=\"c11\"><span class=\"c0\">L&#39;uso di inchiostri magici &egrave; strettamente regolamentato per evitare abusi arcani.</span></p><table class=\"c30\"><tr class=\"c15\"><td class=\"c18\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Grado Inchiostro</span></p></td><td class=\"c7\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Patente</span></p></td><td class=\"c12\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Limite (3 anni)</span></p></td><td class=\"c20\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">Uso Tipico</span></p></td></tr><tr class=\"c23\"><td class=\"c18\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">I (Base)</span></p></td><td class=\"c7\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">P.A.S.V.</span></p></td><td class=\"c12\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">20 boccette</span></p></td><td class=\"c20\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Pergamene LV 1&ndash;2, pozioni semplici</span></p></td></tr><tr class=\"c15\"><td class=\"c18\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">II (Avanzato)</span></p></td><td class=\"c7\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">P.A.S.V.</span></p></td><td class=\"c12\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">15 boccette</span></p></td><td class=\"c20\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Pergamene LV 3&ndash;4, pozioni Non Comuni</span></p></td></tr><tr class=\"c23\"><td class=\"c18\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">III (Raro)</span></p></td><td class=\"c7\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">P.A.S.V.</span></p></td><td class=\"c12\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">10 boccette</span></p></td><td class=\"c20\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Pergamene LV 5&ndash;6, oggetti Rari</span></p></td></tr><tr class=\"c15\"><td class=\"c18\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c2\">IV (M. Raro)</span></p></td><td class=\"c7\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">P.O.E.</span></p></td><td class=\"c12\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">5 boccette</span></p></td><td class=\"c20\" colspan=\"1\" rowspan=\"1\"><p class=\"c3\"><span class=\"c0\">Pergamene LV 7&ndash;9, oggetti Molto Rari</span></p></td></tr></table><p class=\"c11 c26\"><span class=\"c2 c22\"></span></p><ul class=\"c5 lst-kix_l94sysi879wz-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Il Marchio Spettrale</span><span>: Le autorit&agrave; possono risalire al produttore/acquirente di una pozione o pergamena tramite l&#39;incantesimo </span><span class=\"c31\">Analisi del Pigmento</span><span class=\"c0\">.</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.u36o0wat0lkz\"><span class=\"c13 c2\">&#9876;&#65039; Esame di Abilitazione</span></h2><p class=\"c11\"><span>Per ottenere o rinnovare una patente, il candidato deve superare una </span><span class=\"c2\">Prova di Maestria</span><span class=\"c0\">&nbsp;(1 settimana di Downtime).</span></p><ul class=\"c5 lst-kix_fovzcv9gqulb-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Requisiti Comuni</span><span class=\"c0\">: Superamento della prova di abilit&agrave; (CD variabile), Giuramento di Fedelt&agrave; e versamento della Cauzione.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Esempi di Prove</span><span class=\"c0\">:</span></li></ul><ul class=\"c5 lst-kix_fovzcv9gqulb-1 start\"><li class=\"c11 c16 li-bullet-0\"><span class=\"c2\">Oste (P.M.C.)</span><span class=\"c0\">: Preparazione di una pietanza con effetti meccanici (CD 13).</span></li><li class=\"c11 c16 li-bullet-0\"><span class=\"c2\">Metallurgo (P.M.T.)</span><span class=\"c0\">: Creazione di un&#39;armatura media o 5 armi perfette (CD 15).</span></li><li class=\"c11 c16 li-bullet-0\"><span class=\"c2\">Alchimista (P.A.S.V.)</span><span class=\"c0\">: Produzione di 3 diverse pozioni Non Comuni stabili (CD 17).</span></li><li class=\"c11 c16 li-bullet-0\"><span class=\"c2\">Maestro (P.O.E.)</span><span class=\"c0\">: Creazione di un oggetto Raro e valutazione di una commissione (CD 20).</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.74jrpjn1h9zq\"><span class=\"c13 c2\">&#128721; Sistema Sanzionatorio: I Tre Sigilli</span></h2><p class=\"c11\"><span class=\"c0\">Il medaglione della patente reca tre sigilli magici che si infrangono in caso di reati:</span></p><ol class=\"c5 lst-kix_kqy3i5976thp-0 start\" start=\"1\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">1&deg; Sigillo (Infrazione Lieve)</span><span class=\"c0\">: Vendita senza fattura o ritardo nel rinnovo. Multa di 30 Mo e firma settimanale all&#39;U.R.V.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">2&deg; Sigillo (Infrazione Grave)</span><span class=\"c0\">: Vendita di veleni non etichettati o produzione oltre il proprio livello. Sospensione di 6 mesi e multa di 100 Mo.</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">3&deg; Sigillo (Infrazione Gravissima)</span><span>: Commercio con nemici del Regno o falsificazione di documenti. </span><span class=\"c2\">Revoca Permanente</span><span class=\"c0\">, confisca dei beni e possibile bando.</span></li></ol><ul class=\"c5 lst-kix_gv5e3nux907t-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Crimine Arcano</span><span class=\"c0\">: L&#39;uso di arti necrotiche o corruzione della Trama comporta l&#39;esilio permanente immediato.</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><h2 class=\"c9\" id=\"h.42wdmmi5sodb\"><span class=\"c13 c2\">&#128197; Rinnovi e Scadenze</span></h2><ul class=\"c5 lst-kix_pv4zzru18ikl-0 start\"><li class=\"c1 li-bullet-0\"><span class=\"c2\">Periodo di Grazia</span><span>: Fino a 30 giorni dopo la scadenza (solo preavviso). Oltre i 3 mesi la licenza &egrave; considerata </span><span class=\"c2\">Scaduta</span><span class=\"c0\">&nbsp;(sigillo infranto, multa progressiva).</span></li><li class=\"c1 li-bullet-0\"><span class=\"c2\">Procedura</span><span class=\"c0\">: Audit del Libretto degli Acquisti, prova pratica (CD ridotta di 2) e versamento della quota triennale.</span></li></ul><hr><p class=\"c10\"><span class=\"c0\"></span></p><p class=\"c11\"><span class=\"c25\">Documento redatto e sigillato dall&#39;Ufficio del Registro e della Vigilanza di Arcadia.</span></p><p class=\"c21\"><span class=\"c2 c28\"></span></p></body></html>",
