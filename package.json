{
  "name": "arcamis-wiki",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Wiki ufficiale del server D&D Arcamis",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-all.mjs",
    "prebuild:site": "node scripts/gen-collection-search.mjs && node scripts/optimize-images.mjs --quiet",
    "build:site": "vite build && node scripts/build-post.mjs",
    "build:admin": "npm --prefix admin run build",
    "seo": "node scripts/gen-seo-static.mjs",
    "build:summary": "node scripts/build-summary.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "icons": "node scripts/make-icons.mjs",
    "images:opt": "node scripts/optimize-images.mjs",
    "images:check": "node scripts/optimize-images.mjs --check",
    "fonts": "node scripts/fetch-fonts.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name arcamis",
    "preview": "vite preview",
    "lint": "eslint scripts/js/",
    "lint:fix": "eslint scripts/js/ --fix",
    "format": "prettier --write eslint.config.js vite.config.js \"functions/**/*.js\"",
    "format:check": "prettier --check eslint.config.js vite.config.js \"functions/**/*.js\"",
    "typecheck": "echo 'No TypeScript configured yet'",
    "test": "vitest run",
    "test:routes": "npm run build:site && npm run test:dist",
    "test:dist": "vitest run scripts/__tests__/routes.test.js",
    "test:watch": "vitest",
    "predev": "node scripts/gen-collection-search.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.4.0",
    "sharp": "^0.35.5",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "4.156.2"
  }
}
